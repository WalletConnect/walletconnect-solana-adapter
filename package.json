{
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"format": "pnpm dlx @biomejs/biome format . --write",
		"clean": "rm -rf node_modules pnpm-lock.yaml; pnpm -r exec rm -rf node_modules dist",
		"build": "pnpm run build:packages && pnpm run build:playground",
		"watch:packages": "pnpm -F './packages/**' --parallel run watch",
		"build:packages": "pnpm run clean:packages; pnpm -F './packages/**' run build",
		"clean:packages": "pnpm -F './packages/**' exec rm -rf dist",
		"build:playground": "pnpm -F ./playground run build",
		"dev:playground": "pnpm -F ./playground run dev",
		"changeset:pre": "changeset pre enter",
		"changeset:pre:exit": "changeset pre exit",
		"changeset": "changeset",
		"changeset:version": "changeset version",
		"changeset:publish": "pnpm publish:latest",
		"publish:latest": "pnpm install; pnpm build; changeset publish",
		"publish:alpha": "pnpm install; pnpm build; changeset publish --tag alpha",
		"publish:beta": "pnpm install; pnpm build; changeset publish --tag beta",
		"publish:canary": "pnpm install; pnpm build; changeset publish --tag canary"
	},
	"devDependencies": {
		"@biomejs/biome": "1.8.2",
		"@changesets/assemble-release-plan": "6.0.6",
		"@changesets/changelog-github": "0.5.1",
		"@changesets/cli": "2.28.1"
	},
	"packageManager": "pnpm@9.5.0",
	"pnpm": {
		"patchedDependencies": {
			"@changesets/assemble-release-plan@6.0.6": "patches/@changesets__assemble-release-plan@6.0.6.patch"
		},
		"overrides": {
			"minimatch@<3.1.3": "3.1.3",
			"minimatch@>=9 <9.0.6": "9.0.6",
			"bn.js@>=5 <5.2.3": "5.2.3",
			"ajv@<6.14.0": "6.14.0",
			"h3@<1.15.5": "1.15.5",
			"node-forge@<1.3.2": "1.3.2",
			"js-yaml@>=3 <3.14.2": "3.14.2",
			"js-yaml@>=4 <4.1.1": "4.1.1",
			"tmp@<0.2.4": "0.2.4",
			"brace-expansion@<1.1.12": "1.1.12",
			"brace-expansion@>=2 <2.0.2": "2.0.2"
		}
	}
}
